  "original": {
    "research_scenario": {
      "description": "基于分钟级量价数据构建股票的筹码分布，发掘出筹码分布、筹码集中度、筹码换手、筹码盈利四大类因子。",
      "source_locators": [
        "<!-- page: 1 --> 核心观点"
      ]
    },
    "economic_mechanism": {
      "description": "筹码分布反映股票在不同价格区间内的持仓成本分布情况，帮助判断支撑位、压力位以及主力资金的动向。",
      "source_locators": [
        "<!-- page: 1 --> 核心观点"
      ]
    },
    "feature_formulas": [
      {
        "name": "筹码加权平均成本",
        "formula": "mean_{t} = \\sum (price_{i,t} * p_{i,t})",
        "variables": [
          {
            "symbol": "price_{i,t}",
            "meaning": "第i个价位的价格"
          },
          {
            "symbol": "p_{i,t}",
            "meaning": "第i个价位的筹码占比"
          }
        ],
        "source_locators": [
